# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Landing.ai — https://va.landing.ai (free tier, create account first)
LANDINGAI_API_KEY=...

# Optional: override the default OpenAI model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: GCP/Cloud Run persistence settings
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=your-bucket-name
# GCS_BASELINE_PREFIX=baseline
# GCS_UPLOADS_PREFIX=uploads
