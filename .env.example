# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Landing.ai — https://va.landing.ai
LANDINGAI_API_KEY=your-landingai-api-key-here

# Optional: override the default OpenAI chat model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# Optional: GCP / Cloud Run persistence (leave unset for local-only dev)
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GCS_BUCKET_NAME=your-bucket-name
# GCS_BASELINE_PREFIX=baseline
# GCS_UPLOADS_PREFIX=uploads
